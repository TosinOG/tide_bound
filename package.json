{
  "name": "tidebound-gold",
  "version": "1.2.0",
  "description": "Tidebound Gold \u2014 a browser-based Three.js ocean survival and island exploration adventure",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/systems.test.js tests/upgrade.test.js tests/world.test.js tests/islands.test.js",
    "test:browser": "node tests/gameplay.mjs && node tests/endgame.mjs && node tests/regressions.mjs && node tests/islands.mjs",
    "build:standalone": "npm run build && node scripts/package-standalone.mjs",
    "test:all": "npm test && npm run test:browser && npm run test:standalone",
    "test:standalone": "npm run build:standalone && node tests/standalone.mjs",
    "profile": "node tests/profile.mjs islands-after",
    "test:islands": "node --test tests/islands.test.js && node tests/islands.mjs",
    "test:seeds": "node tests/islands-seed-sweep.mjs"
  },
  "dependencies": {
    "three": "0.170.0",
    "vite": "7.3.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
